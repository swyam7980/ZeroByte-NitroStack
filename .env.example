# ─── Backend ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── NitroStack / NitroCloud ───────────────────────────────
NITROSTACK_API_KEY=changeme
NITROSTACK_GATEWAY_URL=https://gateway.nitrocloud.local
NITROSTACK_WORKSPACE=zerobyte-pentester

# Two MCP endpoints (populated after NitroCloud deploy)
MCP_PENTESTER_URL=http://localhost:5101
MCP_REPORTING_URL=http://localhost:5102

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=changeme-dev-secret
JWT_EXPIRY=1h

# ─── Docker / Runners ──────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock
NUCLEI_IMAGE=zerobyte/nuclei:latest
SQLMAP_IMAGE=zerobyte/sqlmap:latest
GITLEAKS_IMAGE=zerobyte/gitleaks:latest

# ─── Scope ─────────────────────────────────────────────────
SCOPE_FILE=./scope.yaml
