{
  "name": "zerobyte-nitrostack",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Pentester — MCP-first system built on NitroStack",
  "workspaces": [
    "packages/*",
    "servers/*",
    "backend",
    "frontend",
    "runners/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:pentester": "npm run dev --workspace servers/pentester-mcp",
    "dev:reporting": "npm run dev --workspace servers/reporting-mcp",
    "dev:servers": "npm run dev --workspace servers/pentester-mcp --workspace servers/reporting-mcp",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rm -rf packages/*/dist servers/*/dist backend/dist frontend/dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0"
  }
}
